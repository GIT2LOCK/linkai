{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkAI",
  "version": "0.2.0",
  "identifier": "com.linkai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinkAI",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 720,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
