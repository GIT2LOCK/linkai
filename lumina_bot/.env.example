# Lumina
LUMINA_USERNAME=
LUMINA_PASSWORD=
LUMINA_EXECUTABLE_PATH=C:\Lumina\Lumina.exe
LUMINA_MAIN_WINDOW_TITLE_RE=.*Lumina.*

# Supabase private bucket. Never use ANON_KEY for this workflow.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
SUPABASE_FOLDER=

# Local processing outputs, resolved from the lumina_bot project folder.
PDF_DOWNLOAD_PATH=output/pdfs
EXCEL_OUTPUT_PATH=output/excel/notas.xlsx

# Operator profile loaded from Supabase Database.
# The backend uses SERVICE_ROLE_KEY and never exposes it to React.
SUPABASE_OPERATOR_TABLE=operators
SUPABASE_OPERATOR_ID=
SUPABASE_OPERATOR_ID_COLUMN=id
SUPABASE_OPERATOR_EMAIL=
SUPABASE_OPERATOR_EMAIL_COLUMN=email
SUPABASE_OPERATOR_USERNAME=
SUPABASE_OPERATOR_USERNAME_COLUMN=username
SUPABASE_OPERATOR_NAME_COLUMN=name
SUPABASE_OPERATOR_ROLE_COLUMN=role
SUPABASE_OPERATOR_AVATAR_URL_COLUMN=avatar_url
OPERATOR_FALLBACK_NAME=Operador
OPERATOR_FALLBACK_ROLE=LinkAI Desktop
